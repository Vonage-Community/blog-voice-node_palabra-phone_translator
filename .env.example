# Vonage application created with `vonage apps create`
VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY_PATH=./private.key

# Your Vonage number (the one people call), in E.164 format without the +, for example 14155550100
VONAGE_NUMBER=

# The phone the app dials when someone calls your Vonage number, in the same format
DESTINATION_NUMBER=

# From https://app.palabra.ai, under API Keys. A new key gives you a Client ID and a Client Secret
PALABRA_CLIENT_ID=
PALABRA_CLIENT_SECRET=

# Language each person speaks. See https://docs.palabra.ai/docs/languages
CALLER_LANGUAGE=es
DESTINATION_LANGUAGE=en

# Volume of the other person's original voice, played only when no translation is playing,
# from 0 (off) to 1 (full volume).
# Off by default: with the translation a second or two behind, hearing both is confusing.
ORIGINAL_VOICE_GAIN=0

PORT=3000

# Used by `vonage tunnel ngrok`. Get one at https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
